# Copy this file to .env and fill in real values. .env is loaded automatically
# by common/config.py (python-dotenv) and should NEVER be committed to git.

# Required: lets the Claude Agent SDK authenticate on a headless EC2 box.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One password variable per instance you define in config/config.yaml.
# The names here are examples -- they must match the "env" key you reference
# under each instance's `password:` field in config.yaml.
ORDERS_PG_PASSWORD=changeme
BILLING_MYSQL_PASSWORD=changeme

# SMTP credentials for outbound email alerts.
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=changeme
